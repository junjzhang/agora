[Unit]
Description=agora — niri workspace manager daemon
Documentation=https://github.com/junjzhang/agora
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agorad
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
